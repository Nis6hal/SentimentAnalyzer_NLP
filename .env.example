# SentimentIQ Environment Configuration
# Copy this file to .env and fill in your values

# Database
# For local development (SQLite, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./sentimentiq.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentimentiq

# Docker Compose PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentimentiq

# ML Inference
MODEL_TYPE=champion   # "champion" (RoBERTa) or "baseline" (TF-IDF LogReg)
DEVICE=cpu            # "cpu" or "cuda"

# CORS (comma-separated frontend origins)
# BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
